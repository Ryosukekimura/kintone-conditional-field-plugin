{
  "name": "kintone-conditional-field-plugin",
  "version": "1.0.0",
  "description": "kintone plugin: show/hide and require fields based on another field value",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "icon": "node scripts/make-icon.mjs",
    "test": "vitest run",
    "typecheck": "tsc",
    "keygen": "cli-kintone plugin keygen --output private.ppk",
    "pack": "npm run build && cli-kintone plugin pack --input plugin/manifest.json --output dist/plugin.zip --private-key private.ppk",
    "upload": "cli-kintone plugin upload --input dist/plugin.zip",
    "preview": "node dev/serve.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@kintone/cli": "^1.21.3",
    "@kintone/dts-gen": "^9.0.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryosukekimura/kintone-conditional-field-plugin.git"
  }
}
